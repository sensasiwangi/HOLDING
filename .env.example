# ============================================
# SWI Holding — Environment Variables
# Copy to .env.local for local development
# ============================================

# ── Portal Authentication ──
INTERNAL_PORTAL_PASSWORD=your_admin_password_here
SESSION_SECRET=your_random_32_char_secret_here
ENABLE_PORTAL_AUTH=false

# ── Google Sheets API ──
# Option 1: Token file at ~/.hermes/google_token.json (local dev)
# Option 2: Environment variables (Vercel/production)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_ACCESS_TOKEN=optional_initial_access_token
GOOGLE_EXPIRY_DATE=optional_token_expiry_timestamp
GOOGLE_REDIRECT_URI=http://localhost:1

# ── Google Sheets IDs ──
# Main spreadsheet (already in code, but documented here)
# SPREADSHEET_ID=1lQ_FX6v-aX0XNwkRO6TyYLU1NGq6lAMFvK88S09KZsA

# ── Optional: OpenAI (for AI features in sensasi-wangi) ──
# OPENAI_API_KEY=sk-...
